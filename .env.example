# 값은 절대 커밋하지 않는다. 실제 값은 .env.local 과 Vercel 환경변수에만 둔다.
# 여기 있는 값은 비밀이 아닌 것(식별자·도메인)만 채워져 있다.

# Airtable — 서버에서만 사용한다. NEXT_PUBLIC_ 접두어를 붙이지 마라.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appzLstFHtHcQlWSu

# Auth.js v5 (Google)
# AUTH_SECRET 생성: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 로컬 개발에서만 필요. Vercel 에서는 설정하지 않는다.
AUTH_URL=http://localhost:3000

# 로그인 허용 도메인. 서버 콜백에서 이메일 도메인을 다시 검증한다.
ALLOWED_HD=open-garden.co.kr

# 모두가 함께 보는 캘린더만 쉼표로 나열한다. 맨 앞이 기본 캘린더 —
# [일정 추가]는 거기에 만든다.
# 개인 캘린더는 넣지 마라. 로그인한 사람 본인 것은 포털이 자동으로 얹는다.
# 공휴일: ko.south_korea#holiday@group.v.calendar.google.com
GOOGLE_CALENDAR_ID=

# 영업 지도(/sales-map)의 네이버 지도 Client ID (Client Secret 아님).
# 브라우저에 드러나는 값이라 비밀은 아니지만, 네이버 클라우드 콘솔 → Maps →
# Application → Web 서비스 URL에 https://app.open-garden.co.kr 이 등록돼 있어야 지도가 뜬다.
# 관공서 지도와 같은 이름(NAVER_MAP_KEY_ID)으로 넣어도 된다.
NAVER_MAPS_CLIENT_ID=
